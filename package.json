{
  "name": "orangehrm-playwright",
  "version": "1.0.0",
  "description": "Playwright + TypeScript automation framework for the OrangeHRM employee lifecycle",
  "private": true,
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:qa": "cross-env TEST_ENV=qa playwright test --project=chromium",
    "test:staging": "cross-env TEST_ENV=staging playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:regression": "playwright test --project=chromium --grep @regression",
    "test:auth": "playwright test --project=chromium --grep @auth",
    "test:lifecycle": "playwright test --project=chromium --grep @lifecycle",
    "test:rbac": "playwright test --project=chromium --grep @rbac",
    "test:headed": "cross-env HEADLESS=false playwright test --project=chromium --workers=1",
    "test:debug": "playwright test --project=chromium --debug",
    "test:firefox": "playwright test --project=firefox",
    "test:all-browsers": "playwright test",
    "report": "playwright show-report playwright-report",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps chromium firefox"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/node": "20.16.11",
    "cross-env": "7.0.3",
    "dotenv": "16.4.5",
    "typescript": "5.6.3"
  }
}
